# =====================================================================
# Plantilla de configuración - Fundación Beit Shalom
#
# LO MÁS FÁCIL: no edites este archivo. Ejecuta   python instalar.py
# y el asistente creará tu archivo .env haciéndote unas preguntas.
#
# Si prefieres hacerlo a mano: copia este archivo con el nombre .env
# y completa los valores. El .env es PRIVADO: cada persona tiene el suyo
# con los datos de SU computadora. No lo compartas ni lo subas a GitHub.
# =====================================================================

# Clave secreta para firmar sesiones y tokens CSRF. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 = modo desarrollo (errores detallados). En producción: 0
FLASK_DEBUG=1

# ---------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------
DB_DRIVER=ODBC Driver 18 for SQL Server

# Instancia predeterminada: localhost
# SQL Server Express:       localhost\SQLEXPRESS   (escríbelo sin comillas)
DB_SERVER=localhost
DB_NAME=BeitShalomDB

# ¿Cómo te conectas a SQL Server? Elige UNA opción:
#
# Opción A - Autenticación de SQL Server con el usuario sa (la de la guía del
#   profesor, sección 13). Funciona en Windows, Linux, Mac y Docker.
#   "sa" es el administrador de SQL Server; su contraseña la eligió quien
#   instaló SQL Server EN ESA COMPUTADORA (o al crear el contenedor de Docker).
#   Cada persona usa la contraseña de su propio SQL Server.
#   En Windows hay que activar el "modo mixto" y habilitar sa en SSMS
#   (GUIA_DE_INSTALACION.pdf, paso 2).
DB_TRUSTED_CONNECTION=no
DB_USER=sa
DB_PASSWORD=
#
# Opción B - Autenticación de Windows (solo en Windows, sin contraseña).
#   SQL Server confía en tu usuario de Windows.
#   Para usarla, reemplaza las tres líneas de la opción A por:
# DB_TRUSTED_CONNECTION=yes
# DB_USER=
# DB_PASSWORD=

DB_ENCRYPT=yes
# yes en desarrollo (certificado autofirmado). En producción, con un certificado válido: no
DB_TRUST_SERVER_CERTIFICATE=yes

# ---------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------
# yes cuando el sitio se publique con HTTPS
SESSION_COOKIE_SECURE=no
SESION_MINUTOS=30

# ---------------------------------------------------------------------
# Primer usuario del panel (opcional; instalar.py lo pregunta)
# Se crea con: flask --app app crear-admin --desde-env
# En la base de datos solo se guarda el hash de la contraseña.
# ---------------------------------------------------------------------
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del sistema
ADMIN_PASSWORD=
